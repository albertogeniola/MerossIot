    "version": "0.2.0",
    "configurations": [
        {
            "name": "Info Collector",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/info_collector.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/.env",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        },
        {
            "name": "Oil Diffuser",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/oil_diffuser.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/.env",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        }
    ]
}